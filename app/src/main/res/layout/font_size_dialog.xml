<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Font Size"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="@font/balsamiqsans_regular"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/font_size_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/font_size_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Small"
            android:fontFamily="@font/balsamiqsans_regular"
            android:textSize="15sp"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/font_size_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medium"
            android:fontFamily="@font/balsamiqsans_regular"
            android:textSize="18sp"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/font_size_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Large"
            android:fontFamily="@font/balsamiqsans_regular"
            android:textSize="22sp"
            android:padding="8dp" />

        <RadioButton
            android:id="@+id/font_size_extra_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Extra Large"
            android:fontFamily="@font/balsamiqsans_regular"
            android:textSize="26sp"
            android:padding="8dp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Font Size Preview"
        android:fontFamily="@font/balsamiqsans_regular"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/font_size_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is how your text will look."
        android:fontFamily="@font/balsamiqsans_regular"
        android:gravity="center"
        android:textSize="18sp"
        android:padding="16dp"
        android:background="?attr/colorSurface"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/font_size_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/font_size_apply_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply" />

    </LinearLayout>

</LinearLayout>
