<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    tools:context=".applock.SetPasscodeScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passcode &amp; Security"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/balsamiqsans_regular"
            android:layout_marginBottom="24dp" />

        <!-- Main Security Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorSurface">

                <!-- Enable Passcode Section -->
                <LinearLayout
                    android:id="@+id/passcode_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/lock_open_24"
                        android:tint="?attr/colorPrimary"
                        android:contentDescription="Lock icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enable Passcode Lock"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/balsamiqsans_regular"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/passcode_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App is password protected"
                            android:textColor="?attr/colorOnSurface"
                            android:alpha="0.7"
                            android:fontFamily="@font/balsamiqsans_regular"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_enable_passcode_lock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"
                    android:alpha="0.1" />

                <!-- Additional Passcode Options -->
                <LinearLayout
                    android:id="@+id/passcode_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Change Passcode Button -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/change_passcode_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/lock_open_24"
                                android:tint="?attr/colorPrimary"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="Change passcode" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Change Passcode"
                                android:textColor="?attr/colorOnSurface"
                                android:fontFamily="@font/balsamiqsans_regular"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOnSurface"
                        android:alpha="0.1"
                        android:layout_marginStart="64dp" />

                    <!-- Reset Passcode Button -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/reset_passcode_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@android:color/transparent">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@android:drawable/ic_menu_delete"
                                android:tint="?attr/colorError"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="Reset passcode" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reset Passcode"
                                android:textColor="?attr/colorError"
                                android:fontFamily="@font/balsamiqsans_regular"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Security Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="?attr/colorSurface">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Security Tips"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Use a passcode that's easy for you to remember but hard for others to guess\n\n• Don't share your passcode with anyone\n\n• If you forget your passcode, you can reset it but you'll need to create a new one"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.8"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
