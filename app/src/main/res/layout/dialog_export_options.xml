<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Format Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Format:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="@font/balsamiqsans_regular"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/format_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/format_pdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PDF (Professional)"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/balsamiqsans_regular"
            android:checked="true"
            android:drawableStart="@drawable/ic_pdf"
            android:drawablePadding="8dp"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/format_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TXT (Plain Text)"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/balsamiqsans_regular"
            android:drawableStart="@drawable/ic_txt"
            android:drawablePadding="8dp"
            android:padding="12dp" />
    </RadioGroup>

    <!-- Options -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Include:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="@font/balsamiqsans_regular"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/include_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tags"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="@font/balsamiqsans_regular"
        android:checked="true"
        android:padding="8dp" />

    <CheckBox
        android:id="@+id/include_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Metadata (word count, export date)"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="@font/balsamiqsans_regular"
        android:checked="true"
        android:padding="8dp" />


</LinearLayout>
