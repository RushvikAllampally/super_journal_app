<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dream_journal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/journal_bg_dream"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingRight="5dp"
        android:paddingLeft="5dp"
        android:paddingBottom="8dp"
        android:elevation="2dp"
        android:background="@color/journal_bg_dream">

        <ImageView
            android:id="@+id/close_journal_dream"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:src="@drawable/icons8_multiply_24"
            android:contentDescription="Close"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/dream_delete_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/delete_icon_24"
            android:contentDescription="Delete"
            android:padding="4dp" />

        <ImageButton
            android:id="@+id/manage_tags_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Manage Tags"
            android:padding="4dp" />

        <Button
            android:id="@+id/save_journal_dream"
            style="@style/Widget.Material3.Button"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:fontFamily="@font/balsamiqsans_regular"
            android:text="Save"
            android:textSize="14sp"
            android:backgroundTint="@color/secondary" />

    </LinearLayout>

    <!-- Date Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/journal_date_state_dream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/balsamiqsans_regular"
            android:text="Today"
            android:textSize="15sp"
            android:textColor="?attr/colorOnBackground" />

        <TextView
            android:id="@+id/selected_journal_date_dream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:fontFamily="@font/balsamiqsans_regular"
            android:text="24th September 2023"
            android:textSize="15sp"
            android:textColor="?attr/colorOnBackground"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/journal_calender_icon_dream"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/calender_view_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Select Date" />

    </LinearLayout>

    <!-- Title Section with Prompt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <com.vanniktech.emoji.EmojiEditText
            android:id="@+id/journal_title_dream"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/balsamiqsans_regular"
            android:hint="Title"
            android:inputType="text"
            android:textSize="18sp"
            android:textColor="?attr/colorOnBackground"
            android:textColorHint="?attr/colorOnBackground"
            android:alpha="0.8"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/icons_color">

            <ImageButton
                android:id="@+id/dream_prompt_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_help"
                android:scaleType="fitCenter"
                android:contentDescription="Get Prompt" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="12dp"
        android:background="?attr/colorOnBackground"
        android:alpha="0.2" />

    <!-- Rich Text Formatting Toolbar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@color/journal_toolbar_bg"
        android:elevation="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/action_undo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toolbar_image_button_background"
                android:src="@drawable/edit_black"
                android:tint="?attr/colorOnSurface"
                android:contentDescription="Undo"
                android:scaleType="centerInside"
                android:padding="10dp" />

            <ImageButton
                android:id="@+id/action_redo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toolbar_image_button_background"
                android:src="@drawable/edit_black"
                android:tint="?attr/colorOnSurface"
                android:contentDescription="Redo"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:rotation="180" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/colorOnSurface"
                android:alpha="0.3" />

            <Button
                android:id="@+id/action_bold"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/toolbar_button_background" />

            <Button
                android:id="@+id/action_italic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="I"
                android:textStyle="italic"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/toolbar_button_background" />

            <Button
                android:id="@+id/action_underline"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="U"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/toolbar_button_background" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/colorOnSurface"
                android:alpha="0.3" />

            <Button
                android:id="@+id/action_heading1"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="H1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/toolbar_button_background" />

            <Button
                android:id="@+id/action_heading2"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="H2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/toolbar_button_background" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/colorOnSurface"
                android:alpha="0.3" />

            <ImageButton
                android:id="@+id/action_bullet"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/toolbar_image_button_background"
                android:src="@drawable/ic_bullet"
                android:tint="?attr/colorOnSurface"
                android:contentDescription="Bullet List"
                android:scaleType="centerInside"
                android:padding="10dp" />

            <Button
                android:id="@+id/action_numbers"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="123"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/toolbar_button_background" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:background="?attr/colorOnSurface"
                android:alpha="0.3" />

            <Button
                android:id="@+id/action_text_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/icons_color"
                android:background="@drawable/toolbar_button_background" />

            <Button
                android:id="@+id/action_font_size"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Aa"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/toolbar_button_background" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Rich Text Editor -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp"
        android:background="@color/journal_writing_area_bg"
        android:elevation="1dp"
        android:padding="4dp">

        <jp.wasabeef.richeditor.RichEditor
            android:id="@+id/journal_content_dream"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/editor_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Describe your dreams..."
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.4"
            android:fontFamily="@font/balsamiqsans_regular"
            android:clickable="false"
            android:focusable="false" />

    </FrameLayout>

    <!-- Word Count -->
    <TextView
        android:id="@+id/word_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 words"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.6"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/balsamiqsans_regular" />

</LinearLayout>
