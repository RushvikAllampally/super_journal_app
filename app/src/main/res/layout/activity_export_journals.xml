<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:elevation="4dp"
        android:background="?attr/colorSurface"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_back"
            android:tint="?attr/colorOnSurface"
            android:contentDescription="Back"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Export Journals"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/balsamiqsans_regular"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Date Range Selection - Clear & Intuitive -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Quick Preset Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/preset_week_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last 7 Days"
                android:textSize="11sp"
                android:fontFamily="@font/balsamiqsans_regular"
                android:layout_marginEnd="6dp"
                android:textColor="?attr/colorOnSurface"
                android:paddingVertical="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/preset_month_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last 30 Days"
                android:textSize="11sp"
                android:fontFamily="@font/balsamiqsans_regular"
                android:layout_marginEnd="6dp"
                android:textColor="?attr/colorOnSurface"
                android:paddingVertical="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/preset_all_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All Time"
                android:textSize="11sp"
                android:fontFamily="@font/balsamiqsans_regular"
                android:textColor="?attr/colorOnSurface"
                android:paddingVertical="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Custom Date Range Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/date_range_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="1dp"
            app:cardCornerRadius="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="?attr/colorOnSurface"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom Date Range"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:alpha="0.7" />

                    <TextView
                        android:id="@+id/selected_date_range_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nov 6 - Dec 6, 2025"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_edit"
                    android:tint="?attr/colorOnSurface"
                    android:alpha="0.6" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Selection Controls -->
    <LinearLayout
        android:id="@+id/selection_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/select_all_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select All"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/balsamiqsans_regular" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/selected_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 selected"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/balsamiqsans_regular"
            android:alpha="0.7" />
    </LinearLayout>

    <!-- Content Area (RecyclerView + Empty State) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Journal List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/journals_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="48dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_calendar"
                android:tint="?attr/colorOnSurface"
                android:alpha="0.3"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a date range to view journals"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/balsamiqsans_regular"
                android:alpha="0.6"
                android:gravity="center"
                android:textAlignment="center" />
        </LinearLayout>
    </FrameLayout>

    <!-- Export Button (Fixed at Bottom) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/export_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Export"
        android:textColor="@color/on_primary"
        android:fontFamily="@font/balsamiqsans_regular"
        app:icon="@drawable/ic_export"
        app:iconTint="@color/on_primary"
        app:backgroundTint="@color/text_primary"
        android:visibility="gone" />

</LinearLayout>
