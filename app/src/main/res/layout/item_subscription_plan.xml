<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/plan_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeWidth="2dp"
    app:strokeColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Plan Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/plan_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Premium"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="@font/balsamiqsans_bold" />

                <TextView
                    android:id="@+id/plan_savings_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Best Value - Save 50%"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/success_green"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/balsamiqsans_bold"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/plan_price_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$2.99"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/app_blue"
                android:fontFamily="@font/balsamiqsans_bold" />

        </LinearLayout>

        <!-- Plan Description -->
        <TextView
            android:id="@+id/plan_description_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full access to all premium features"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/balsamiqsans_regular" />

        <!-- Select Plan Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/select_plan_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Choose This Plan"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/balsamiqsans_bold"
            style="@style/Widget.Material3.Button"
            app:backgroundTint="@color/app_blue"
            app:cornerRadius="12dp" />

        <!-- Features Preview (Optional) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/success_green"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All premium features included"
                android:textSize="12sp"
                android:textColor="@color/success_green"
                android:fontFamily="@font/balsamiqsans_regular" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
