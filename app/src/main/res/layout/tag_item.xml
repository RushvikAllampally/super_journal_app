<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tag_chip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:textSize="14sp"
    android:fontFamily="@font/balsamiqsans_regular"
    android:textColor="?attr/colorOnSurface"
    app:chipBackgroundColor="?attr/colorSurface"
    app:chipStrokeColor="?attr/colorPrimary"
    app:chipStrokeWidth="1dp"
    app:chipIcon="@drawable/tag_24"
    app:chipIconTint="?attr/colorPrimary"
    app:rippleColor="?attr/colorPrimary"
    app:chipIconVisible="true"
    app:checkedIconVisible="true"
    app:checkedIcon="@drawable/check_circle_24"
    app:closeIconVisible="false"
    style="@style/Widget.MaterialComponents.Chip.Choice" />
