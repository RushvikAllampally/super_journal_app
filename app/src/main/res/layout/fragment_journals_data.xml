<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:scrollbars="none"
    android:background="?attr/android:colorBackground"
    tools:context=".screens.fragments.JournalsDataFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Journal Insights"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#6200EE"
            android:fontFamily="@font/balsamiqsans_regular"
            android:layout_marginBottom="8dp" />
            
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your personalized writing analytics"
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="#888888"
            android:fontFamily="@font/balsamiqsans_regular"
            android:layout_marginBottom="16dp" />

        <!-- Journal Overview -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Journal Overview"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:layout_marginBottom="16dp" />

                <!-- Stats Grid Layout -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:useDefaultMargins="true"
                    android:alignmentMode="alignBounds">
                    
                    <!-- Total Entries Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        app:cardBackgroundColor="#E8F5E9"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Entries"
                                android:textSize="14sp"
                                android:fontFamily="@font/balsamiqsans_regular" />
                                
                            <TextView
                                android:id="@+id/total_entries"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/balsamiqsans_regular"
                                android:text="0" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    
                    <!-- Current Streak Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        app:cardBackgroundColor="#E3F2FD"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current Streak"
                                android:textSize="14sp"
                                android:fontFamily="@font/balsamiqsans_regular" />
                                
                            <TextView
                                android:id="@+id/current_streak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/balsamiqsans_regular"
                                android:text="0" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    
                    <!-- Weekly Entries Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        app:cardBackgroundColor="#FFF3E0"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Last Week"
                                android:textSize="14sp"
                                android:fontFamily="@font/balsamiqsans_regular" />
                                
                            <TextView
                                android:id="@+id/last_week_entries"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/balsamiqsans_regular"
                                android:text="0" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    
                    <!-- Most Productive Day Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        app:cardBackgroundColor="#F3E5F5"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Best Day"
                                android:textSize="14sp"
                                android:fontFamily="@font/balsamiqsans_regular" />
                                
                            <TextView
                                android:id="@+id/most_productive_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/balsamiqsans_regular"
                                android:text="N/A" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    
                    <!-- Average Mood Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        app:cardBackgroundColor="#E8EAF6"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Average Mood"
                                android:textSize="14sp"
                                android:fontFamily="@font/balsamiqsans_regular" />
                                
                            <TextView
                                android:id="@+id/average_mood"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/balsamiqsans_regular"
                                android:text="N/A" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    
                    <!-- Average Words Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        app:cardBackgroundColor="#FFEBEE"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_margin="4dp">
                        
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg Words"
                                android:textSize="14sp"
                                android:fontFamily="@font/balsamiqsans_regular" />
                                
                            <TextView
                                android:id="@+id/average_word_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/balsamiqsans_regular"
                                android:text="N/A" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </GridLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        
        <!-- Journal Types Chart -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Journal Types"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:layout_marginBottom="8dp" />
                
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/journal_types_chart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        
        <!-- Weekly Activity Chart -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Weekly Activity (Last 30 Days)"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:layout_marginBottom="4dp" />
                    
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your journal entries by day of week"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:layout_marginBottom="8dp" />
                
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/weekly_activity_chart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        
        <!-- Mood Trends Chart -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Mood Trends"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:layout_marginBottom="4dp" />
                    
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mood levels recorded over the last month"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:layout_marginBottom="8dp" />
                
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/mood_trends_chart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>