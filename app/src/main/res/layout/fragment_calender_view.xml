<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical"
    tools:context=".screens.fragments.CalenderViewFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="Calender View"
            android:fontFamily="@font/balsamiqsans_regular"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:elevation="4dp"
        app:cardCornerRadius="10dp">

        <CalendarView
            android:id="@+id/calender_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="Journals written on this Day"
        android:fontFamily="@font/balsamiqsans_regular"
        android:textSize="20sp" />

    <ImageView
        android:id="@+id/nothing_found_calender_view"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/empty_state_illustration"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        />

    <TextView
        android:id="@+id/nothing_found_calender_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No journal entries on this date.\nSelect another date or start writing!"
        android:textSize="16sp"
        android:textColor="?attr/colorOnBackground"
        android:fontFamily="@font/balsamiqsans_regular"
        android:textAlignment="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="15dp"
        android:paddingBottom="25dp"
        android:layout_marginHorizontal="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/calender_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:paddingBottom="30dp"
        android:clipToPadding="false" />

</LinearLayout>