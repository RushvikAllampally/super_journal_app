<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical"
    tools:context=".screens.settings.ReminderScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:elevation="4dp"
        android:background="?attr/colorSurface"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:fontFamily="@font/balsamiqsans_regular"
            android:text="Reminders"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Journal Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/colorSurface"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurface"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:text="Journal"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"
                    android:alpha="0.5" />

                <!-- My Diary Item -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="?attr/colorSecondary"
                        android:src="@drawable/ic_diary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="My Diary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/reflective_notification_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="8:00 PM"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/reflective_time_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clock"
                        app:tint="?attr/colorSecondary"
                        android:tag="diary" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/reflective_notification_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:tag="diary"
                        app:thumbTint="@color/switch_thumb_selector" />
                </LinearLayout>

                <!-- Gratitude Journal Item -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="?attr/colorSecondary"
                        android:src="@drawable/ic_gratitude" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="Gratitude Journal"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/gratitude_notification_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="8:00 PM"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/gratitude_time_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clock"
                        app:tint="?attr/colorSecondary"
                        android:tag="gratitude" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/gratitude_notification_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:tag="gratitude"
                        app:thumbTint="@color/switch_thumb_selector" />
                </LinearLayout>

                <!-- Bullet Journal Item -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="?attr/colorSecondary"
                        android:src="@drawable/ic_bullet" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="Bullet Journal"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/bullet_notification_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="8:00 PM"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/bullet_time_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clock"
                        app:tint="?attr/colorSecondary"
                        android:tag="bullet" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/bullet_notification_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:tag="bullet"
                        app:thumbTint="@color/switch_thumb_selector" />
                </LinearLayout>

                <!-- Dream Journal Item -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="?attr/colorSecondary"
                        android:src="@drawable/ic_dream" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="Dream Journal"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/dream_notification_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="8:00 PM"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/dream_time_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clock"
                        app:tint="?attr/colorSecondary"
                        android:tag="dream" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/dream_notification_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:tag="dream"
                        app:thumbTint="@color/switch_thumb_selector" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notifications Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/colorSurface"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurface"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:text="Notifications"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"
                    android:alpha="0.5" />

                <!-- Quote of the Day Item -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="?attr/colorSecondary"
                        android:src="@drawable/ic_quote" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="Quote of the Day"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/quote_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="8:00 PM"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/quote_time_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clock"
                        app:tint="?attr/colorSecondary"
                        android:tag="quote" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/quote_notification_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:tag="quote"
                        app:thumbTint="@color/switch_thumb_selector" />
                </LinearLayout>

                <!-- Daily Affirmation Item -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="?attr/colorSecondary"
                        android:src="@drawable/ic_affirmation" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="Daily Affirmation"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/affirmation_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="8:00 PM"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/affirmation_time_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clock"
                        app:tint="?attr/colorSecondary"
                        android:tag="affirmation" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/affirmation_notification_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:tag="affirmation"
                        app:thumbTint="@color/switch_thumb_selector" />
                </LinearLayout>
            </LinearLayout>

            <!-- Habits Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/colorSurface"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurface"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:text="Habits"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"
                    android:alpha="0.5" />

                <!-- Today's Mood Item -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:tint="?attr/colorSecondary"
                        android:src="@drawable/ic_mood" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="Today's Mood"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/mood_rem_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textColor="?attr/colorOnSurface"
                        android:text="8:00 PM"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/mood_rem_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clock"
                        app:tint="?attr/colorSecondary"
                        android:tag="mood" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/mood_rem_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:tag="mood"
                        app:thumbTint="@color/switch_thumb_selector" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
