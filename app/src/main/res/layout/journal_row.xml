<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        android:elevation="5dp"
        app:cardCornerRadius="7dp"
        app:cardUseCompatPadding="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <LinearLayout
                android:id="@+id/journal_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="11dp">

                <!-- Date and Month section -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/journal_row_date"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="24th"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/journal_row_month"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="June"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                </LinearLayout>

                <!-- Title, Details and Tags section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="30dp"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/journal_row_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="Title of the day"
                        android:fontFamily="@font/balsamiqsans_regular"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/journal_row_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Details"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.8"
                        android:layout_marginTop="10dp"
                        android:textSize="15sp"
                        android:maxLines="2"
                        android:ellipsize="end" />
                    
                    <LinearLayout
                        android:id="@+id/journal_row_tags_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">
                        
                        <TextView
                            android:id="@+id/journal_row_tags"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:fontFamily="@font/balsamiqsans_regular"
                            android:textColor="?attr/colorPrimary"
                            android:ellipsize="end"
                            android:maxLines="1" />
                            
                        <ImageButton
                            android:id="@+id/journal_tags_button"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_edit"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="?attr/colorPrimary"
                            android:contentDescription="Edit Tags" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            
            <!-- Bookmark button -->
            <ImageButton
                android:id="@+id/journal_bookmark_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_bookmark"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_alignParentRight="true"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:contentDescription="Bookmark Journal" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>