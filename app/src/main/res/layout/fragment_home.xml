<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical"
    tools:context=".screens.fragments.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="2dp">

        <ImageButton
            android:id="@+id/profile_btn"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_margin="5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/transparent_profile_icon" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginRight="5dp"
            android:layout_marginTop="2dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:src="@drawable/transparent_streak_img" />

                <TextView
                    android:id="@+id/streak_edit_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="9dp"
                    android:text="45"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Streak"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/balsamiqsans_regular" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/rate_mood_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="5dp"
            android:background="@drawable/rate_day_icon_one" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="8dp"
        android:elevation="4dp"
        app:cardCornerRadius="15dp">

        <LinearLayout
            android:id="@+id/quote_container"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/quote_background"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Elegant gradient overlay for better text visibility -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/quote_text_background"
                android:padding="16dp"
                android:orientation="vertical">

                <!-- Greeting text -->
                <TextView
                    android:id="@+id/hi_quote_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:text="Hi, User"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/quote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:text="What gets monitored, gets improved!"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/quote_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:text="-- Rushvik"
                    android:textAlignment="textEnd"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/next_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:paddingBottom="5dp"
        android:layout_marginBottom="5dp"
        android:descendantFocusability="blocksDescendants"
        android:scrollbarSize="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:orientation="vertical">


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/affirmation_card_background"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lightbulb"
                        android:tint="@color/text_secondary"
                        android:layout_marginEnd="12dp"
                        android:alpha="0.8" />

                    <!-- Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Header -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/balsamiqsans_regular"
                            android:text="Daily Affirmation"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:alpha="0.7"
                            android:layout_marginBottom="4dp" />

                        <!-- Affirmation text -->
                        <TextView
                            android:id="@+id/affirmation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/balsamiqsans_regular"
                            android:text="I am confident and capable"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <!-- Subtle accent -->
                    <View
                        android:layout_width="3dp"
                        android:layout_height="40dp"
                        android:background="@color/secondary"
                        android:alpha="0.3"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/tasks_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/balsamiqsans_regular"
                            android:text="Your Tasks !!"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/home_pin_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="10dp"
                            android:tint="?attr/colorOnSurface"
                            android:src="@drawable/unpin_icon" />

                        <ImageView
                            android:id="@+id/edit_bullet_journal"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginHorizontal="5dp"
                            android:tint="?attr/colorOnSurface"
                            android:src="@drawable/edit_black" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_layout_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:orientation="vertical">
                        <!-- This is the container where your TextView elements will be added dynamically -->
                    </LinearLayout>

                    <!--                    <TextView-->
                    <!--                        android:layout_width="wrap_content"-->
                    <!--                        android:layout_height="wrap_content"-->
                    <!--                        android:text="You Don't Have Any tasks Set"-->
                    <!--                        android:fontFamily="@font/balsamiqsans_regular"-->
                    <!--                        android:layout_gravity="center"-->
                    <!--                        />-->

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:text="Recent Journal Entries"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="22sp" />

                <ImageView
                    android:id="@+id/nothing_found_home_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/first_journal_img" />

                <TextView
                    android:id="@+id/nothing_found_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Start your journaling journey!\nTap the + button to write your first entry"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnBackground"
                    android:fontFamily="@font/balsamiqsans_regular"
                    android:textAlignment="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="15dp"
                    android:paddingBottom="25dp"
                    android:layout_marginHorizontal="24dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:paddingBottom="30dp"
                    android:clipToPadding="false" />

            </LinearLayout>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</LinearLayout>