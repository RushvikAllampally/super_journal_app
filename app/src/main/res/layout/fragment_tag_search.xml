<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:background="?attr/android:colorBackground"
    tools:context=".screens.fragments.TagSearchFragment">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search by Tags"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/balsamiqsans_regular"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Instructions (only shown when tags exist) -->
    <TextView
        android:id="@+id/instructions_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap tags to select, then search below"
        android:textSize="14sp"
        android:textColor="#757575"
        android:fontFamily="@font/balsamiqsans_regular"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <!-- Tags Container with enhanced styling -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="4dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp"
        android:visibility="gone"
        android:id="@+id/tags_card_container">
        
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tags_scroll_container"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:padding="4dp"
            android:overScrollMode="ifContentScrolls"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@color/text_primary"
            android:scrollbarSize="4dp"
            android:scrollbarTrackVertical="?attr/colorSurface"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical"
            android:visibility="visible">
        
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/all_tags_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="2dp"
                app:flexWrap="wrap"
                app:alignItems="center"
                app:alignContent="flex_start"
                app:flexDirection="row"
                app:justifyContent="flex_start" />
                
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>

    <!-- No Tags State -->
    <LinearLayout
        android:id="@+id/no_tags_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingVertical="48dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_tag_outline"
            android:alpha="0.3"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No tags available yet"
            android:textSize="18sp"
            android:textColor="#757575"
            android:fontFamily="@font/balsamiqsans_regular"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create journal entries with tags to search by them"
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:fontFamily="@font/balsamiqsans_regular"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <!-- Selected Count and Action Buttons -->
    <LinearLayout
        android:id="@+id/action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selected_count_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 tags selected"
            android:textSize="14sp"
            android:textColor="#757575"
            android:fontFamily="@font/balsamiqsans_regular" />

        <Button
            android:id="@+id/clear_tags_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"
            style="?android:attr/borderlessButtonStyle"
            android:visibility="gone" />

        <Button
            android:id="@+id/search_by_tag_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textAllCaps="false"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- Results Label -->
    <TextView
        android:id="@+id/search_results_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:text="Journal Results"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/balsamiqsans_regular"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Results RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tag_search_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@color/secondary"
        android:scrollbarSize="4dp"
        android:visibility="gone" />

    <!-- No Results Text -->
    <TextView
        android:id="@+id/no_results_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No journals found with selected tags"
        android:textSize="16sp"
        android:textColor="#757575"
        android:fontFamily="@font/balsamiqsans_regular"
        android:gravity="center"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

</LinearLayout>
